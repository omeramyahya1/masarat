{
  "name": "@masarat/api",
  "version": "0.0.0",
  "private": true,
  "description": "Masarat API (Hono on Bun), used by the owner and government portals",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@masarat/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.10.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11"
  }
}
