# Copy to .env (Bun loads it automatically). Values suit local development.
# development | production. Production refuses to start with the development pricing formula,
# with demo mode on, or with any setting below left to its local default.
APP_ENV=development
# The API connects as the least-privileged role (reads and writes rows, never changes the schema);
# migrations and seeding as the owner. `bun run db:migrate` gives masarat_app this password locally.
DATABASE_URL=postgres://masarat_app:masarat_app@localhost:5433/masarat
MIGRATION_DATABASE_URL=postgres://masarat:masarat@localhost:5433/masarat
# Connections kept open to Postgres (default 10)
DB_POOL_MAX=10
# Time limits: Postgres stops an API query after STATEMENT_TIMEOUT_MS (an export's after
# EXPORT_STATEMENT_TIMEOUT_MS); Bun gives up on a silent request after REQUEST_TIMEOUT_S (max 255)
STATEMENT_TIMEOUT_MS=15000
EXPORT_STATEMENT_TIMEOUT_MS=120000
REQUEST_TIMEOUT_S=30
PORT=3000
# How long a stopping API (SIGTERM) waits for the requests in flight
SHUTDOWN_GRACE_MS=25000
# Local scratch space (exports being built)
STORAGE_DIR=storage

# Logs: JSON lines on stdout and daily files in LOG_DIR (empty: stdout only), deleted after
# LOG_RETENTION_DAYS. LOG_LEVEL: trace | debug | info | warn | error. Development pretty-prints
# the console unless LOG_PRETTY=false. INSTANCE_NAME names this server in the logs (hostname).
LOG_LEVEL=debug
LOG_DIR=logs
LOG_RETENTION_DAYS=7
LOG_PRETTY=true
INSTANCE_NAME=
# Seeds the demo fleet companies on startup and enables the demo-only actions. Off in production.
DEMO_MODE=true

# The web apps (no trailing slash). Only these origins may call the API with the session cookie.
SITE_URL=http://localhost:5175
OWNER_URL=http://localhost:5173
GOVT_URL=http://localhost:5174
# Production: .masarat.com, so owner. and govt. share the session cookie. Leave empty locally.
COOKIE_DOMAIN=
# Set when the API runs behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Sudan time: trip dates and monthly groups use it, whatever the host's zone
TZ=Africa/Khartoum
