{
  "name": "@masarat/api",
  "version": "0.0.0",
  "private": true,
  "description": "Masarat API (Hono on Bun), used by the owner and government portals",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test",
    "user:create-admin": "bun src/scripts/createAdmin.ts"
  },
  "dependencies": {
    "@masarat/shared": "workspace:*",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.10.4",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11"
  }
}
