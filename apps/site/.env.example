# Copy to .env.local to override. The defaults below are the local development URLs.
# Production: https://api.masarat.com, https://masarat.com, https://owner.masarat.com, https://govt.masarat.com
VITE_API_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:5175
VITE_OWNER_URL=http://localhost:5173
VITE_GOVT_URL=http://localhost:5174
# The language choice is a cookie shared by the three sites: .masarat.com in production, unset locally
VITE_COOKIE_DOMAIN=
