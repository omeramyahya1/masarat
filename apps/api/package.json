{
  "name": "@masarat/api",
  "version": "0.0.0",
  "private": true,
  "description": "Masarat API (Hono on Bun), used by the owner and government portals",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test",
    "user:create-admin": "bun src/scripts/createAdmin.ts",
    "load:seed": "bun src/scripts/loadSeed.ts"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.1",
    "@hono/zod-validator": "^0.9.1",
    "@masarat/shared": "workspace:*",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fflate": "0.8.2",
    "hono": "^4.10.4",
    "hono-openapi": "^1.6.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0"
  }
}
